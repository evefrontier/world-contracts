# ============================================
# SUI NETWORK CONFIGURATION
# ============================================
SUI_NETWORK=localnet

# Custom RPC URL (optional, defaults to public endpoints)
# SUI_RPC_URL=https://fullnode.devnet.sui.io:443
# For localnet in Docker, use: http://host.docker.internal:9000 (Mac/Windows)
# For localnet in Docker on Linux, use: http://172.17.0.1:9000 (or your host IP)

# Comma-separated admin account addresses (each a valid 0x Sui address)
# e.g. ADMIN_ADDRESSES=0x202d...a7b0,0x...
ADMIN_ADDRESSES=
# Comma-separated sponsor addresses (gas sponsors for player transactions)
SPONSOR_ADDRESSES=


# ============================================
# TYPESCRIPT EXAMPLES CONFIGURATION
# ============================================
# Required for running TypeScript examples
# Private keys
ADMIN_PRIVATE_KEY=
PLAYER_A_PRIVATE_KEY=
PLAYER_B_PRIVATE_KEY=

# Tenant
TENANT=dev

# Fuel Configuration
FUEL_TYPE_IDS=78437,78515,78516,84868,88319,88335
FUEL_EFFICIENCIES=90,80,40,40,15,10

# Energy Configuration
ASSEMBLY_TYPE_IDS=77917,84556,84955,87119,87120,88063,88064,88067,88068,88069,88070,88071,88082,88083,90184,91978,92279,92401,92404
ENERGY_REQUIRED_VALUES=500,10,950,50,250,100,200,100,200,100,200,300,50,100,1,100,10,20,40
