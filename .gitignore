# Move build artifacts
**/**/build
**/**/target
**/**/.trace
**/**/.coverage*

# Node.js dependencies
node_modules/

# OS generated files
.DS_Store

# IDE / Editor files
.vscode/
.idea/
*.log

# Deployment debug files (raw publish JSON, logs). Commit only the per-env
# world.json supplement for published envs; localnet stays ephemeral.
deployments/**
!deployments/*/
!deployments/*/world.json
deployments/localnet/world.json
.env

# docs
docs/features/
prd.md

# contracts
contracts/**/Pub.*.toml
# ephemeral publish files (shared pubfile lives under deployments/)
Pub.*.toml

# Error decoder build artifacts
tools/error-decoder/*.js
tools/error-decoder/*.js.map
tools/error-decoder/error-map.json
tools/error-decoder/dist/
dist/
.replay/

# pnpm-store when pnpm install executed in containers
.pnpm-store

docs/v1/
