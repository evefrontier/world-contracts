{
    "name": "@evefrontier/world-sdk",
    "version": "0.0.0",
    "type": "module",
    "description": "TypeScript SDK for the EVE Frontier world-contracts",
    "license": "MIT",
    "author": "EVE Frontier",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsx scripts/copy-presets.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
        "create:character": "tsx scripts/create-character.ts",
        "configure:admins": "tsx scripts/configure-admins.ts"
    },
    "peerDependencies": {
        "@mysten/sui": "^2.0.0"
    },
    "devDependencies": {
        "@mysten/sui": "catalog:",
        "@types/node": "catalog:",
        "dotenv": "^17.2.3",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}