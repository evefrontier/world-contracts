/// `Killmail` is the immutable record of a ship or structure loss in player-to-player combat.
/// It is generated by the game and reported by players.
///
/// Stores loss information such as the killer, victim, timestamp, and solar system in which the loss occurs.
module killmail::record;

use character::identity::{Self, Identity};
use core::{admin_service::AdminACL, entity::{Self, Entity}, entity_key::{Self, EntityKey}};
use killmail::registry::KillmailRegistry;
use sui::{derived_object, event};

// === Errors ===
#[error(code = 0)]
const EKillmailIdEmpty: vector<u8> = b"Killmail ID cannot be empty";

#[error(code = 1)]
const EKillerIdEmpty: vector<u8> = b"Killer ID cannot be empty";

#[error(code = 2)]
const EVictimIdEmpty: vector<u8> = b"Victim ID cannot be empty";

#[error(code = 3)]
const EReporterNotCharacter: vector<u8> = b"Reporter entity has no identity component";

#[error(code = 4)]
const ESolarSystemIdEmpty: vector<u8> = b"Solar system ID cannot be empty";

#[error(code = 5)]
const EInvalidLossType: vector<u8> = b"Invalid loss type";

#[error(code = 6)]
const EInvalidTimestamp: vector<u8> = b"Invalid timestamp";

#[error(code = 7)]
const EKillmailAlreadyExists: vector<u8> = b"Killmail with this ItemId already exists";

#[error(code = 8)]
const ENotSponsor: vector<u8> = b"Sender is not an authorized sponsor";

// === Enums ===
/// Represents the type of loss in a killmail
public enum LossType has copy, drop, store {
    SHIP,
    STRUCTURE,
}

// === Structs ===
/// Represents a killmail as a shared object on the Sui blockchain
/// Can be queried directly using its Sui object ID
public struct Killmail has key {
    id: UID,
    key: EntityKey,
    killer_id: EntityKey,
    victim_id: EntityKey,
    reported_by_character_id: EntityKey,
    kill_timestamp: u64, // Unix timestamp in seconds
    loss_type: LossType,
    solar_system_id: EntityKey,
}

// === Events ===
/// Emitted when a new killmail is created
public struct KillmailCreatedEvent has copy, drop {
    key: EntityKey,
    killer_id: EntityKey,
    victim_id: EntityKey,
    reported_by_character_id: EntityKey,
    loss_type: LossType,
    kill_timestamp: u64, // Unix timestamp in seconds
    solar_system_id: EntityKey,
}

// === View Functions ===
// Returns the unique ID of the killmail object
public fun id(killmail: &Killmail): ID {
    object::id(killmail)
}

/// Returns the SHIP variant of LossType
public fun ship(): LossType {
    LossType::SHIP
}

/// Returns the STRUCTURE variant of LossType
public fun structure(): LossType {
    LossType::STRUCTURE
}

/// Unique key for this killmail (used for dedupe and derivation).
public fun key(killmail: &Killmail): EntityKey {
    killmail.key
}

/// In-game ID of the killer character.
public fun killer_id(killmail: &Killmail): EntityKey {
    killmail.killer_id
}

/// In-game ID of the victim (ship or structure).
public fun victim_id(killmail: &Killmail): EntityKey {
    killmail.victim_id
}

/// Character who reported the kill.
public fun reported_by_character_id(killmail: &Killmail): EntityKey {
    killmail.reported_by_character_id
}

/// Unix timestamp (seconds) of the kill.
public fun kill_timestamp(killmail: &Killmail): u64 {
    killmail.kill_timestamp
}

/// Whether the loss was a ship or structure.
public fun loss_type(killmail: &Killmail): LossType {
    killmail.loss_type
}

/// Solar system where the kill occurred.
public fun solar_system_id(killmail: &Killmail): EntityKey {
    killmail.solar_system_id
}

/// Returns true if the loss was a structure
public fun is_structure_loss(killmail: &Killmail): bool {
    killmail.loss_type == LossType::STRUCTURE
}

/// Returns true if the loss was a ship
public fun is_ship_loss(killmail: &Killmail): bool {
    killmail.loss_type == LossType::SHIP
}

// === Admin Functions ===
/// Creates a new killmail as a shared object on-chain
/// Only authorized admin can create killmails
public fun create_killmail(
    registry: &mut KillmailRegistry,
    reporter: &Entity,
    admin_acl: &AdminACL,
    item_id: u64,
    killer_id: u64,
    victim_id: u64,
    kill_timestamp: u64,
    loss_type: u8,
    solar_system_id: u64,
    ctx: &mut TxContext,
) {
    assert!(admin_acl.is_sponsor(ctx.sender()), ENotSponsor);
    assert!(item_id != 0, EKillmailIdEmpty);
    assert!(killer_id != 0, EKillerIdEmpty);
    assert!(victim_id != 0, EVictimIdEmpty);
    assert!(solar_system_id != 0, ESolarSystemIdEmpty);
    assert!(kill_timestamp > 0, EInvalidTimestamp);
    assert!(
        reporter.has_component_with_type<Identity>(identity::component_id()),
        EReporterNotCharacter,
    );

    let reporter_key = reporter.key();
    let tenant = reporter_key.tenant();

    let killmail_key = entity_key::new(item_id, tenant);
    assert!(!registry.exists(killmail_key), EKillmailAlreadyExists);

    // Create the killmail as a shared object on-chain
    let killmail = Killmail {
        id: derived_object::claim(registry.borrow_id(), killmail_key),
        key: killmail_key,
        killer_id: entity_key::new(killer_id, tenant),
        victim_id: entity_key::new(victim_id, tenant),
        reported_by_character_id: reporter_key,
        kill_timestamp,
        loss_type: loss_type_from_u8(loss_type),
        solar_system_id: entity_key::new(solar_system_id, tenant),
    };

    event::emit(KillmailCreatedEvent {
        key: killmail.key,
        killer_id: killmail.killer_id,
        victim_id: killmail.victim_id,
        reported_by_character_id: killmail.reported_by_character_id,
        loss_type: killmail.loss_type,
        kill_timestamp: killmail.kill_timestamp,
        solar_system_id: killmail.solar_system_id,
    });
    transfer::share_object(killmail);
}

/// Converts proto LossType u8 to LossType enum (1=SHIP, 2=STRUCTURE).
/// Aborts with EInvalidLossType for LOSS_UNSPECIFIED (0) or unknown values.
fun loss_type_from_u8(loss_type: u8): LossType {
    match (loss_type) {
        1 => LossType::SHIP,
        2 => LossType::STRUCTURE,
        _ => abort EInvalidLossType,
    }
}
