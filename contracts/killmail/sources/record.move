/// Killmails on chain: the record of a ship or structure loss in player-to-player combat.
///
/// A `Killmail` is generated by the game and reported on behalf of a player character. It
/// lives at an object derived from its `KillmailKey` on the `KillmailRegistry`, and it is
/// shared once created. No function mutates or deletes it.
///
/// Creation follows the request pattern: `create_killmail` returns the record with a
/// sponsor-gated `Request` (issued via `request::new_for`); the transaction satisfies it
/// (`admin_service::verify_sponsor`), then `complete_killmail` shares the record.
module killmail::record;

use character::identity::{Self, Identity};
use core::{admin_service, entity::Entity, entity_key::{Self, EntityKey}, request::{Self, Request}};
use killmail::registry::{Self, KillmailKey, KillmailRegistry};
use std::internal::Permit;
use sui::{derived_object, event};

// === Errors ===

#[error(code = 0)]
const EKillerIdEmpty: vector<u8> = b"Killer ID cannot be empty";
#[error(code = 1)]
const EVictimIdEmpty: vector<u8> = b"Victim ID cannot be empty";
#[error(code = 2)]
const EReporterNotCharacter: vector<u8> = b"Reporter entity has no identity component";
#[error(code = 3)]
const ESolarSystemIdEmpty: vector<u8> = b"Solar system ID cannot be empty";
#[error(code = 4)]
const EInvalidLossType: vector<u8> = b"Invalid loss type";
#[error(code = 5)]
const EInvalidTimestamp: vector<u8> = b"Invalid timestamp";
#[error(code = 6)]
const EKillmailAlreadyExists: vector<u8> = b"Killmail with this ItemId already exists";

// === Constants ===

const VERSION: u64 = 1;

// === Structs ===

/// Issuer of killmail creation requests.
public struct Create() has drop;

/// Whether a ship or a structure was lost.
public enum LossType has copy, drop, store {
    SHIP,
    STRUCTURE,
}

/// One loss. Shared at creation; no function mutates or deletes it.
public struct Killmail has key {
    id: UID, // derived from KillmailRegistry + key
    version: u64,
    key: KillmailKey,
    killer_id: EntityKey,
    victim_id: EntityKey,
    reported_by_character_id: EntityKey,
    kill_timestamp: u64, // Unix timestamp in seconds
    loss_type: LossType,
    solar_system_id: EntityKey,
}

// === Events ===

/// Emitted when a killmail is created and shared.
public struct KillmailCreated has copy, drop {
    key: KillmailKey,
    id: ID,
    killer_id: EntityKey,
    victim_id: EntityKey,
    reported_by_character_id: EntityKey,
    loss_type: LossType,
    kill_timestamp: u64, // Unix timestamp in seconds
    solar_system_id: EntityKey,
}

// === Public Functions ===

/// A ship was lost.
public fun ship(): LossType { LossType::SHIP }

/// A structure was lost.
public fun structure(): LossType { LossType::STRUCTURE }

// === View Functions ===

/// Object ID of the killmail.
public fun id(killmail: &Killmail): ID { object::id(killmail) }

/// Package version the killmail was created under.
public fun version(killmail: &Killmail): u64 { killmail.version }

/// Unique key for this killmail (used for dedupe and derivation).
public fun key(killmail: &Killmail): KillmailKey { killmail.key }

/// In-game ID of the killer character.
public fun killer_id(killmail: &Killmail): EntityKey { killmail.killer_id }

/// In-game ID of the victim (ship or structure).
public fun victim_id(killmail: &Killmail): EntityKey { killmail.victim_id }

/// Character who reported the kill.
public fun reported_by_character_id(killmail: &Killmail): EntityKey {
    killmail.reported_by_character_id
}

/// Unix timestamp (seconds) of the kill.
public fun kill_timestamp(killmail: &Killmail): u64 { killmail.kill_timestamp }

/// Whether the loss was a ship or structure.
public fun loss_type(killmail: &Killmail): LossType { killmail.loss_type }

/// Solar system where the kill occurred.
public fun solar_system_id(killmail: &Killmail): EntityKey { killmail.solar_system_id }

/// Returns true if the loss was a structure.
public fun is_structure_loss(killmail: &Killmail): bool {
    killmail.loss_type == LossType::STRUCTURE
}

/// Returns true if the loss was a ship.
public fun is_ship_loss(killmail: &Killmail): bool { killmail.loss_type == LossType::SHIP }

// === Admin Functions ===

/// Start creating a killmail. Returns the record and a sponsor-gated `Request`: the
/// transaction must satisfy it (`admin_service::verify_sponsor`), then call
/// `complete_killmail`. The killmail takes the reporter's tenant. `loss_type` is the
/// game's proto value (1 = ship, 2 = structure).
public fun create_killmail(
    registry: &mut KillmailRegistry,
    reporter: &Entity,
    killmail_id: u64,
    killer_id: u64,
    victim_id: u64,
    kill_timestamp: u64,
    loss_type: u8,
    solar_system_id: u64,
): (Killmail, Request) {
    assert!(killer_id != 0, EKillerIdEmpty);
    assert!(victim_id != 0, EVictimIdEmpty);
    assert!(solar_system_id != 0, ESolarSystemIdEmpty);
    assert!(kill_timestamp > 0, EInvalidTimestamp);
    assert!(
        reporter.has_component_with_type<Identity>(identity::component_id()),
        EReporterNotCharacter,
    );

    let reporter_key = reporter.key();
    let tenant = reporter_key.tenant();
    let killmail_key = registry::new_key(tenant, killmail_id);
    assert!(!registry.exists(killmail_key), EKillmailAlreadyExists);

    let killmail = Killmail {
        id: derived_object::claim(registry.borrow_id(), killmail_key),
        version: VERSION,
        key: killmail_key,
        killer_id: entity_key::new(killer_id, tenant),
        victim_id: entity_key::new(victim_id, tenant),
        reported_by_character_id: reporter_key,
        kill_timestamp,
        loss_type: loss_type_from_u8(loss_type),
        solar_system_id: entity_key::new(solar_system_id, tenant),
    };
    let request = request::new_for(create_permit(), vector[admin_service::sponsor_requirement()]);
    (killmail, request)
}

/// Finish a killmail once its request is satisfied: emit `KillmailCreated` and share the
/// record.
public fun complete_killmail(killmail: Killmail, request: Request) {
    request.complete_for(create_permit());
    emit_created(&killmail);
    transfer::share_object(killmail);
}

// === Private Functions ===

fun emit_created(killmail: &Killmail) {
    event::emit(KillmailCreated {
        key: killmail.key,
        id: killmail.id.to_inner(),
        killer_id: killmail.killer_id,
        victim_id: killmail.victim_id,
        reported_by_character_id: killmail.reported_by_character_id,
        loss_type: killmail.loss_type,
        kill_timestamp: killmail.kill_timestamp,
        solar_system_id: killmail.solar_system_id,
    });
}

/// Converts the game's proto `LossType` (1 = ship, 2 = structure) to `LossType`.
/// Aborts with `EInvalidLossType` for `LOSS_UNSPECIFIED` (0) or unknown values.
fun loss_type_from_u8(loss_type: u8): LossType {
    match (loss_type) {
        1 => LossType::SHIP,
        2 => LossType::STRUCTURE,
        _ => abort EInvalidLossType,
    }
}

/// Only this module defines `Create`, so only it can issue and complete killmail requests.
fun create_permit(): Permit<Create> {
    internal::permit<Create>()
}

// === Test Functions ===

#[test_only]
public fun created_key(event: &KillmailCreated): KillmailKey { event.key }

#[test_only]
public fun created_id(event: &KillmailCreated): ID { event.id }

/// Create and share a killmail without the sponsor check, for other packages' tests.
/// Returns the record's ID.
#[test_only]
public fun create_for_testing(
    registry: &mut KillmailRegistry,
    reporter: &Entity,
    killmail_id: u64,
    killer_id: u64,
    victim_id: u64,
    kill_timestamp: u64,
    loss_type: u8,
    solar_system_id: u64,
): ID {
    let (killmail, request) = create_killmail(
        registry,
        reporter,
        killmail_id,
        killer_id,
        victim_id,
        kill_timestamp,
        loss_type,
        solar_system_id,
    );
    request.destroy();
    let id = killmail.id.to_inner();
    emit_created(&killmail);
    transfer::share_object(killmail);
    id
}
