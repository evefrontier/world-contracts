/// `Killmail` component: the record of a ship or structure loss in player-to-player combat.
/// It is generated by the game and reported by players.
///
/// Each killmail is its own `Entity`, claimed from the `ObjectRegistry` with the killmail's
/// game id, with this component installed on it. The entity's key is the killmail's key, so
/// the registry dedupes killmails and derives their object ids.
///
/// Stores loss information such as the killer, victim, timestamp, and solar system in which
/// the loss occurs.
module killmail::record;

use character::identity::{Self, Identity};
use core::{
    component::{Self, Component},
    entity::Entity,
    entity_key::{Self, EntityKey},
    request::Request
};
use std::{internal::Permit, string::{Self, String}};
use sui::event;

// === Errors ===

#[error(code = 0)]
const EInvalidLossType: vector<u8> = b"Invalid loss type";
#[error(code = 1)]
const EWrongVersion: vector<u8> = b"Killmail component version does not match the package version";
#[error(code = 2)]
const EComponentMissing: vector<u8> = b"Killmail component is not installed on this entity";
#[error(code = 3)]
const EReporterNotCharacter: vector<u8> = b"Reporter does not have the identity component";

// === Constants ===

const VERSION: u64 = 1;
const NAME: vector<u8> = b"killmail";

// === Structs ===

/// Represents the type of loss in a killmail
public enum LossType has copy, drop, store {
    SHIP,
    STRUCTURE,
}

/// Killmail state installed on a killmail `Entity`.
public struct Killmail has store {
    killer_id: EntityKey,
    victim_id: EntityKey,
    reported_by_character_id: EntityKey,
    kill_timestamp: u64, // Unix timestamp in seconds
    loss_type: LossType,
    solar_system_id: EntityKey,
}

// === Events ===

/// Emitted when a killmail component is installed on its entity.
public struct KillmailCreated has copy, drop {
    killmail_id: ID,
    key: EntityKey,
    killer_id: EntityKey,
    victim_id: EntityKey,
    reported_by_character_id: EntityKey,
    loss_type: LossType,
    kill_timestamp: u64, // Unix timestamp in seconds
    solar_system_id: EntityKey,
}

// === Public Functions ===

/// Build and install the killmail component on a freshly claimed killmail entity.
/// Returns an admin-gated `Request`; only an admin can record a killmail.
public fun install(
    entity: &mut Entity,
    reporter: &Entity,
    killer_id: u64,
    victim_id: u64,
    kill_timestamp: u64,
    loss_type: u8,
    solar_system_id: u64,
    ctx: &mut TxContext,
): Request {
    assert!(
        reporter.has_component_with_type<Identity>(identity::component_id()),
        EReporterNotCharacter,
    );

    let key = entity.key();
    let tenant = key.tenant();

    let killmail = Killmail {
        killer_id: entity_key::new(killer_id, tenant),
        victim_id: entity_key::new(victim_id, tenant),
        reported_by_character_id: reporter.key(),
        kill_timestamp,
        loss_type: loss_type_from_u8(loss_type),
        solar_system_id: entity_key::new(solar_system_id, tenant),
    };

    event::emit(KillmailCreated {
        killmail_id: entity.id(),
        key,
        killer_id: killmail.killer_id,
        victim_id: killmail.victim_id,
        reported_by_character_id: killmail.reported_by_character_id,
        loss_type: killmail.loss_type,
        kill_timestamp: killmail.kill_timestamp,
        solar_system_id: killmail.solar_system_id,
    });

    entity.install(
        component_id(),
        option::some(component_label()),
        killmail,
        VERSION,
        killmail_permit(),
        ctx,
    )
}

/// Remove the killmail component, discarding its state. Aborts if it was never installed.
public fun uninstall(entity: &mut Entity, ctx: &mut TxContext): Request {
    assert!(entity.has_component_with_type<Killmail>(component_id()), EComponentMissing);

    let (c, req) = entity.uninstall<Killmail>(component_id(), killmail_permit(), ctx);
    let Killmail {
        killer_id: _,
        victim_id: _,
        reported_by_character_id: _,
        kill_timestamp: _,
        loss_type: _,
        solar_system_id: _,
    } = c.unwrap(killmail_permit());
    req
}

// === View Functions ===

/// In-game ID of the killer character.
public fun killer_id(entity: &Entity): EntityKey {
    borrow(entity).killer_id
}

/// In-game ID of the victim (ship or structure).
public fun victim_id(entity: &Entity): EntityKey {
    borrow(entity).victim_id
}

/// Character who reported the kill.
public fun reported_by_character_id(entity: &Entity): EntityKey {
    borrow(entity).reported_by_character_id
}

/// Unix timestamp (seconds) of the kill.
public fun kill_timestamp(entity: &Entity): u64 {
    borrow(entity).kill_timestamp
}

/// Whether the loss was a ship or structure.
public fun loss_type(entity: &Entity): LossType {
    borrow(entity).loss_type
}

/// Solar system where the kill occurred.
public fun solar_system_id(entity: &Entity): EntityKey {
    borrow(entity).solar_system_id
}

/// Returns true if the loss was a structure
public fun is_structure_loss(entity: &Entity): bool {
    borrow(entity).loss_type == LossType::STRUCTURE
}

/// Returns true if the loss was a ship
public fun is_ship_loss(entity: &Entity): bool {
    borrow(entity).loss_type == LossType::SHIP
}

/// Deterministic component slot for the killmail component.
public fun component_id(): u64 {
    component::id_from_name(NAME)
}

// === Private Functions ===

/// Converts proto LossType u8 to LossType enum (1=SHIP, 2=STRUCTURE).
/// Aborts with EInvalidLossType for LOSS_UNSPECIFIED (0) or unknown values.
fun loss_type_from_u8(loss_type: u8): LossType {
    match (loss_type) {
        1 => LossType::SHIP,
        2 => LossType::STRUCTURE,
        _ => abort EInvalidLossType,
    }
}

fun borrow_component(entity: &Entity): &Component<Killmail> {
    let c: &Component<Killmail> = entity.component_ref(component_id(), killmail_permit());
    assert!(component::version(c) == VERSION, EWrongVersion);
    c
}

fun borrow(entity: &Entity): &Killmail {
    borrow_component(entity).inner()
}

fun component_label(): String {
    string::utf8(NAME)
}

fun killmail_permit(): Permit<Killmail> {
    internal::permit<Killmail>()
}
